# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Auth + Postgres). Copia estas claves a .env.local
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only: Dashboard → Settings → API → service_role (recálculo matching)
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth (login con Gmail) — no van en .env, se configuran en dashboards:
# 1) Google Cloud Console → APIs & Services → Credentials → OAuth client (Web)
#    Authorized redirect URI:
#    https://<PROJECT_REF>.supabase.co/auth/v1/callback
# 2) Supabase Dashboard → Authentication → Providers → Google
#    pegá Client ID y Client Secret
# 3) Supabase → Authentication → URL Configuration
#    Site URL: http://localhost:3000
#    Redirect URLs: http://localhost:3000/auth/callback
#    (y el puerto que uses en local, p.ej. http://localhost:3003/auth/callback)

# Auth.js / NextAuth v5
# Generar: `npx auth secret` o `openssl rand -base64 32`
AUTH_SECRET=replace-with-a-long-random-string
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# GitHub OAuth (https://github.com/settings/developers)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# PostgreSQL (Prisma)
# Local: postgresql://USER:PASSWORD@localhost:5432/ai_builders?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_builders?schema=public"
# En Vercel/Neon/Supabase, usa la URL directa (sin pooler) para migraciones:
# DIRECT_URL="postgresql://..."
# Fuerza el Prisma Adapter (persistir usuarios). Por defecto se desactiva si
# DATABASE_URL apunta a localhost y no hay Postgres en marcha.
# AUTH_ADAPTER=true

# APIs externas (añade las que uses)
# OPENAI_API_KEY=
# STRIPE_SECRET_KEY=
